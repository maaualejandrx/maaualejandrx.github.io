---
const S = (d: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;

const T = `M12 3c-1.5 0-2.8.9-3.2 2.2C7.8 7.4 7.8 10.5 8.3 13.5l.9 5c.4 1.4 1.1 2 2.3 2s1.9-.8 1.9-2.2v-2.5c0-.9.9-.9.9 0v2.5c0 1.4.7 2.2 1.9 2.2s1.9-.6 2.3-2l.9-5c.5-3 .5-6.1-.5-8.3C18.5 3.8 17 3 15.5 3c-1.1 0-1.9.5-1.9 1.2C13.5 3.5 12.8 3 12 3z`;

const servicios = [
  {
    cat: 'Estética',     color: '#0076c8',
    name: 'Blanqueamiento dental',
    icon: S(`<path d="${T}"/>
      <path d="M19.5 1l.5 1.6 1.6.5-1.6.5-.5 1.6-.5-1.6-1.6-.5 1.6-.5z" fill="currentColor" stroke="none"/>
      <circle cx="21" cy="7.5" r=".8" fill="currentColor" stroke="none"/>
      <path d="M4 4.5l.4 1.1 1.1.4-1.1.4L4 7.5l-.4-1.1-1.1-.4 1.1-.4z" fill="currentColor" stroke="none"/>
      <circle cx="5.5" cy="9.5" r=".6" fill="currentColor" stroke="none"/>`),
  },
  {
    cat: 'Estética',     color: '#0076c8',
    name: 'Diseño de sonrisa',
    icon: S(`<circle cx="12" cy="11.5" r="8.5"/>
      <path d="M8 14.5c.8 2.5 2.2 3.5 4 3.5s3.2-1 4-3.5" stroke-width="1.8"/>
      <line x1="9" y1="14.5" x2="15" y2="14.5" stroke-width="1.3" opacity=".5"/>
      <circle cx="9.5" cy="9" r="1.3" fill="currentColor" stroke="none"/>
      <circle cx="14.5" cy="9" r="1.3" fill="currentColor" stroke="none"/>
      <path d="M20.5 2l.5 1.6 1.6.5-1.6.5-.5 1.6-.5-1.6-1.6-.5 1.6-.5z" fill="currentColor" stroke="none"/>`),
  },
  {
    cat: 'Estética',     color: '#0076c8',
    name: 'Carillas de porcelana',
    icon: S(`<path d="${T}"/>
      <path d="M9 5.8C9.9 4 11 3 12 3c1.3 0 2.4.9 3.2 2.8" stroke-width="4" opacity=".18" stroke-linecap="round"/>
      <path d="M9 5.8C9.9 4 11 3 12 3c1.3 0 2.4.9 3.2 2.8" stroke-width="1.8" stroke-linecap="round"/>
      <path d="M9.8 4.5C10.5 3.2 11.2 2.6 12 2.6c1 0 1.8.6 2.4 1.9" stroke-width="1" opacity=".35" stroke-linecap="round"/>`),
  },
  {
    cat: 'Ortodoncia',   color: '#6366f1',
    name: 'Brackets metálicos',
    icon: S(`<rect x="2" y="8.5" width="5" height="7" rx="1.5"/>
      <rect x="9.5" y="7" width="5" height="10" rx="1.5"/>
      <rect x="17" y="8.5" width="5" height="7" rx="1.5"/>
      <line x1="2" y1="12" x2="22" y2="12" stroke-width="2"/>
      <circle cx="4.5" cy="12" r="1.3" fill="currentColor" stroke="none"/>
      <circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none"/>
      <circle cx="19.5" cy="12" r="1.3" fill="currentColor" stroke="none"/>`),
  },
  {
    cat: 'Ortodoncia',   color: '#6366f1',
    name: 'Alineadores invisibles',
    icon: S(`<path d="M3 18C3 10.5 7 4 12 4s9 6.5 9 14"/>
      <path d="M6.5 18c0-5.5 2.5-10 5.5-10s5.5 4.5 5.5 10"/>
      <line x1="3" y1="18" x2="21" y2="18" stroke-width="1.8"/>
      <line x1="6.5" y1="18" x2="17.5" y2="18" stroke-width="3.5" stroke-linecap="round" opacity=".25"/>`),
  },
  {
    cat: 'Restauración', color: '#d97706',
    name: 'Coronas dentales',
    icon: S(`<path d="M4.5 20l2-11 3.5 4.5L12 5l2 8.5 3.5-4.5 2 11z" fill="currentColor" opacity=".1" stroke="none"/>
      <path d="M4.5 20l2-11 3.5 4.5L12 5l2 8.5 3.5-4.5 2 11"/>
      <line x1="4.5" y1="20" x2="19.5" y2="20" stroke-width="2"/>
      <circle cx="4.5" cy="8.5" r="1.8" fill="currentColor" stroke="none"/>
      <circle cx="12" cy="4.5" r="1.8" fill="currentColor" stroke="none"/>
      <circle cx="19.5" cy="8.5" r="1.8" fill="currentColor" stroke="none"/>`),
  },
  {
    cat: 'Restauración', color: '#d97706',
    name: 'Empastes y resinas',
    icon: S(`<path d="${T}"/>
      <rect x="9.5" y="6.5" width="5" height="4.5" rx="1.2" fill="currentColor" stroke="none" opacity=".25"/>
      <rect x="9.5" y="6.5" width="5" height="4.5" rx="1.2"/>
      <line x1="9.5" y1="8.75" x2="14.5" y2="8.75" stroke-width="1" opacity=".4"/>`),
  },
  {
    cat: 'Implantes',    color: '#059669',
    name: 'Implantes dentales',
    icon: S(`<line x1="9" y1="2.5" x2="15" y2="2.5" stroke-width="2.5" stroke-linecap="round"/>
      <line x1="12" y1="2.5" x2="12" y2="13.5"/>
      <line x1="9.5" y1="5" x2="14.5" y2="5"/>
      <line x1="9" y1="7.5" x2="15" y2="7.5"/>
      <line x1="9" y1="10" x2="15" y2="10"/>
      <line x1="9.5" y1="12.5" x2="14.5" y2="12.5"/>
      <circle cx="12" cy="18" r="4.5"/>
      <circle cx="12" cy="18" r="2.5" fill="currentColor" stroke="none" opacity=".2"/>`),
  },
  {
    cat: 'Implantes',    color: '#059669',
    name: 'All-on-4',
    icon: S(`<path d="M3.5 19C3.5 11 7 5 12 5s8.5 6 8.5 14"/>
      <line x1="3.5" y1="19" x2="20.5" y2="19" stroke-width="1.8"/>
      <line x1="7" y1="14.5" x2="7" y2="19" stroke-width="2.5"/>
      <line x1="10.5" y1="10.5" x2="10.5" y2="19" stroke-width="2.5"/>
      <line x1="13.5" y1="10.5" x2="13.5" y2="19" stroke-width="2.5"/>
      <line x1="17" y1="14.5" x2="17" y2="19" stroke-width="2.5"/>
      <circle cx="7" cy="14" r="2" fill="currentColor" stroke="none"/>
      <circle cx="10.5" cy="10" r="2" fill="currentColor" stroke="none"/>
      <circle cx="13.5" cy="10" r="2" fill="currentColor" stroke="none"/>
      <circle cx="17" cy="14" r="2" fill="currentColor" stroke="none"/>`),
  },
  {
    cat: 'Periodoncia',  color: '#0d9488',
    name: 'Limpieza dental',
    icon: S(`<path d="${T}"/>
      <path d="M4.5 5.5 C4 6.2 4 7 4.5 7.8" stroke-width="1.4" opacity=".7"/>
      <path d="M3 9 C2.5 9.9 2.5 10.8 3 11.6" stroke-width="1.3" opacity=".55"/>
      <path d="M5.5 12.5 C5 13.2 5 14 5.5 14.5" stroke-width="1.2" opacity=".4"/>
      <path d="M19.5 5.5 C20 6.2 20 7 19.5 7.8" stroke-width="1.4" opacity=".7"/>
      <path d="M21 9 C21.5 9.9 21.5 10.8 21 11.6" stroke-width="1.3" opacity=".55"/>`),
  },
  {
    cat: 'Infantil',     color: '#ec4899',
    name: 'Odontopediatría',
    icon: S(`<circle cx="12" cy="11.5" r="8.5"/>
      <path d="M8 15c.9 2.8 2.4 4 4 4s3.1-1.2 4-4" stroke-width="1.8"/>
      <line x1="9" y1="15" x2="15" y2="15" stroke-width="1.3" opacity=".45"/>
      <path d="M9 8.5c.4-1 1.1-1.5 1.8-1.5s1.4.5 1.8 1.5" stroke-width="1.5"/>
      <path d="M11.4 8.5c.4-1 1.1-1.5 1.8-1.5s1.4.5 1.8 1.5" stroke-width="1.5"/>
      <path d="M21 2l.4 1.2 1.2.4-1.2.4L21 5.2l-.4-1.2-1.2-.4 1.2-.4z" fill="currentColor" stroke="none"/>`),
  },
  {
    cat: 'Endodoncia',   color: '#7c3aed',
    name: 'Endodoncia',
    icon: S(`<path d="${T}"/>
      <line x1="12" y1="7" x2="12" y2="19" stroke-width="1.4" opacity=".5"/>
      <path d="M12 10l-2 3h4z" fill="currentColor" stroke="none" opacity=".35"/>
      <path d="M12 14l-1.5 2.5h3z" fill="currentColor" stroke="none" opacity=".28"/>
      <path d="M12 17l-1 2h2z" fill="currentColor" stroke="none" opacity=".2"/>
      <path d="M10 7.5L12 6l2 1.5" stroke-width="1.5" opacity=".6"/>`),
  },
  {
    cat: 'Cirugía',      color: '#e11d48',
    name: 'Extracción dental',
    icon: S(`<path d="M5 3.5C5 2.1 6.1 1 7.5 1S10 2.1 10 3.5c0 2-2.2 3.8-2.5 5.5"/>
      <path d="M5 14.5C5 13.1 6.1 12 7.5 12S10 13.1 10 14.5c0 2-2.2 3.8-2.5 5.5"/>
      <path d="M7.5 9l14 8.5" stroke-width="2.2"/>
      <path d="M7.5 20l14-5.5" stroke-width="2.2"/>
      <path d="M14 17.5l-6.5-8" stroke-width="1.5" opacity=".45"/>`),
  },
];

const row1 = servicios;
const row2 = [...servicios.slice(7), ...servicios.slice(0, 7)];
const row3 = [...servicios.slice(4), ...servicios.slice(0, 4)];
---

<section id="services-section"
  class="w-full min-h-screen flex flex-col justify-center py-20 relative overflow-hidden z-20 reveal-section"
  style="background: linear-gradient(165deg,#f0f8ff 0%,#fff 50%,#f5f9ff 100%)">

  <!-- Blobs decorativos -->
  <div class="pointer-events-none absolute -top-40 -left-40 w-[600px] h-[600px] rounded-full opacity-30"
    style="background:radial-gradient(circle,#0076c8 0%,transparent 65%);filter:blur(90px)"></div>
  <div class="pointer-events-none absolute -bottom-40 -right-40 w-[500px] h-[500px] rounded-full opacity-20"
    style="background:radial-gradient(circle,#6366f1 0%,transparent 65%);filter:blur(80px)"></div>

  <div class="relative w-full max-w-[1440px] mx-auto px-4 sm:px-8 flex flex-col items-center gap-16">

    <!-- Cabecera -->
    <div class="text-center space-y-5 w-full reveal-item">
      <h2 class="text-5xl sm:text-6xl xl:text-7xl font-black text-[#0c1230] tracking-tighter leading-none">
        <span class="rl"><span class="rl-i" style="--td:0ms">Cuidado dental para</span></span><br/>
        <span class="rl"><span class="rl-i text-[#0076c8]" style="--td:130ms">cada momento</span></span>
        <span class="rl"><span class="rl-i" style="--td:210ms"> de tu vida</span></span>
      </h2>
      <p class="text-base sm:text-lg text-[#64748b] max-w-xl mx-auto leading-relaxed reveal-item [transition-delay:200ms]">
        Más de 13 tratamientos especializados para cuidar tu sonrisa en cada etapa de la vida, con tecnología de última generación.
      </p>
    </div>

    <!-- Marquee triple fila -->
    <div class="srv-marquee-outer reveal-item [transition-delay:300ms]">

      <!-- Fila 1: scroll izquierda -->
      <div class="srv-marquee-track srv-scroll-l">
        {[...row1, ...row1].map((s) => (
          <div class="srv-pill" style={`--c:${s.color}`}>
            <div class="srv-pill-icon" style={`color:${s.color}`} set:html={s.icon}></div>
            <div class="srv-pill-text">
              <span class="srv-pill-cat" style={`color:${s.color}`}>{s.cat}</span>
              <span class="srv-pill-name">{s.name}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Fila 2: scroll derecha -->
      <div class="srv-marquee-track srv-scroll-r">
        {[...row2, ...row2].map((s) => (
          <div class="srv-pill" style={`--c:${s.color}`}>
            <div class="srv-pill-icon" style={`color:${s.color}`} set:html={s.icon}></div>
            <div class="srv-pill-text">
              <span class="srv-pill-cat" style={`color:${s.color}`}>{s.cat}</span>
              <span class="srv-pill-name">{s.name}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Fila 3: scroll izquierda lento -->
      <div class="srv-marquee-track srv-scroll-l3">
        {[...row3, ...row3].map((s) => (
          <div class="srv-pill" style={`--c:${s.color}`}>
            <div class="srv-pill-icon" style={`color:${s.color}`} set:html={s.icon}></div>
            <div class="srv-pill-text">
              <span class="srv-pill-cat" style={`color:${s.color}`}>{s.cat}</span>
              <span class="srv-pill-name">{s.name}</span>
            </div>
          </div>
        ))}
      </div>

    </div>

    <!-- CTA -->
    <a href="#contacto-section" class="srv-cta reveal-item [transition-delay:500ms]">
      <span>Agenda tu tratamiento</span>
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <path d="M5 12h14M13 6l6 6-6 6"/>
      </svg>
    </a>

  </div>
</section>

<style>
  /* ── Outer: fade lateral ── */
  .srv-marquee-outer {
    width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 16px;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 6%,
      black 94%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 6%,
      black 94%,
      transparent 100%
    );
  }

  /* ── Track ── */
  .srv-marquee-track {
    display: flex;
    gap: 14px;
    width: max-content;
    will-change: transform;
  }

  .srv-scroll-l  { animation: srv-kf-l 38s linear infinite; }
  .srv-scroll-r  { animation: srv-kf-r 46s linear infinite; }
  .srv-scroll-l3 { animation: srv-kf-l 54s linear infinite; }

  .srv-marquee-track:hover {
    animation-play-state: paused;
  }

  @keyframes srv-kf-l {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @keyframes srv-kf-r {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }

  /* ── Pill card ── */
  .srv-pill {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 18px 26px;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.92);
    border-radius: 22px;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    box-shadow:
      0 2px 20px rgba(0, 0, 0, 0.06),
      0 1px 4px rgba(0, 0, 0, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
    white-space: nowrap;
    flex-shrink: 0;
    cursor: default;
    transition:
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.25s ease;
  }

  .srv-pill:hover {
    transform: translateY(-5px) scale(1.03);
    box-shadow:
      0 16px 48px color-mix(in srgb, var(--c) 18%, transparent),
      0 4px 14px rgba(0, 0, 0, 0.07),
      inset 0 1px 0 white;
  }

  /* Ícono con fondo tintado */
  .srv-pill-icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--c) 10%, rgba(255, 255, 255, 0.6));
    border: 1px solid color-mix(in srgb, var(--c) 18%, rgba(255, 255, 255, 0.7));
    border-radius: 14px;
    padding: 9px;
  }
  .srv-pill-icon svg {
    width: 100%;
    height: 100%;
    stroke-width: 1.5;
  }

  /* Texto apilado: categoría + nombre */
  .srv-pill-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .srv-pill-cat {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
    line-height: 1;
  }

  .srv-pill-name {
    font-size: 1rem;
    font-weight: 700;
    color: #0c1230;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  /* ── CTA ── */
  .srv-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 30px;
    border-radius: 18px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #0c1230;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(24px) saturate(200%);
    -webkit-backdrop-filter: blur(24px) saturate(200%);
    border: 1px solid rgba(255, 255, 255, 0.88);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.07),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
    transition:
      transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.28s ease,
      color 0.2s ease;
  }
  .srv-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, transparent 55%);
    pointer-events: none;
  }
  .srv-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.4) 50%, transparent 70%);
    transform: translateX(-120%);
    transition: transform 0.5s ease;
  }
  .srv-cta:hover::after { transform: translateX(120%); }
  .srv-cta:hover {
    transform: translateY(-3px);
    color: #0076c8;
    box-shadow: 0 12px 36px rgba(0, 118, 200, 0.13), inset 0 1px 0 white;
  }
  .srv-cta span,
  .srv-cta svg { position: relative; z-index: 1; }
  .srv-cta svg { transition: transform 0.25s ease; }
  .srv-cta:hover svg { transform: translateX(4px); }
</style>

<script>
  function initServicios() {
    const section = document.getElementById('services-section') as HTMLElement;
    if (!section) return;
    section.classList.remove('active');
    new IntersectionObserver((entries, obs) => {
      if (entries[0].isIntersecting) { section.classList.add('active'); obs.disconnect(); }
    }, { rootMargin: '0px 0px -15% 0px', threshold: 0 }).observe(section);
  }

  initServicios();
  document.addEventListener('astro:page-load', initServicios);
</script>
