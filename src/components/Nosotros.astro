---
import { Image } from 'astro:assets';
import nosotrosComposicionImg from '../images/nosotros-composicion.png';  
import decorationImg from '../images/decoration.png';  
import limpiezaImg from '../images/limpieza.png';  
import extraccionImg from '../images/extraccion.png'; 
---

<!-- 1. Añadimos la clase 'reveal-section' manteniendo tus estilos de fondo y sombras -->
<section id="nosotros-section" class="w-full min-h-screen flex items-center bg-[#FAFAFA] py-0 overflow-hidden relative z-10 shadow-[0_-20px_50px_rgba(0,0,0,0.03)] reveal-section">
  <div class="w-full max-w-[1440px] mx-auto px-4 sm:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    
    <!-- BLOQUE IZQUIERDO CON ANIMACIONES DE ENTRADA Y HOVERS INTERACTIVOS -->
    <div class="lg:col-span-7 flex flex-col items-start text-left space-y-8 pr-0 lg:pr-12 pb-12">
      
      <!-- STAT CARDS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 w-full">

        <!-- Card 1: Precios accesibles -->
        <div class="stat-card" data-anim="left" style="--td:0ms">
          <div class="stat-card-header">
            <span class="stat-icon stat-icon-blue">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </span>
            <span class="stat-badge stat-badge-blue">Accesible para todos</span>
          </div>
          <div class="stat-metric text-[#0076c8]">Flex</div>
          <div class="stat-sub">planes de pago disponibles</div>
          <p class="stat-desc">Opciones de pago adaptadas a tu presupuesto para que cuides tu salud bucal sin preocupaciones económicas.</p>
        </div>

        <!-- Card 2: Pacientes atendidos -->
        <div class="stat-card" data-anim="right" style="--td:120ms">
          <div class="stat-card-header">
            <span class="stat-icon stat-icon-amber">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/>
              </svg>
            </span>
            <span class="stat-badge stat-badge-amber">Certificada UJAT</span>
          </div>
          <div class="stat-metric text-[#F5A623]">+<span data-count="800">0</span></div>
          <div class="stat-sub">pacientes atendidos</div>
          <p class="stat-desc">Cirujana dentista certificada con años de trayectoria, equipada con tecnología moderna para ofrecerte resultados de alta calidad.</p>
        </div>

      </div>

      <!-- TÍTULO PRINCIPAL -->
      <h2 class="text-4xl sm:text-5xl xl:text-6xl font-black text-[#0c1230] tracking-tighter leading-[1.1] w-full max-w-2xl">
        <span class="rl"><span class="rl-i" style="--td:0ms">La cirujana dentista más</span></span><br/>
        <span class="rl"><span class="rl-i text-[#0076c8]" style="--td:130ms">confiable</span></span>
        <span class="rl"><span class="rl-i" style="--td:210ms"> que puedes encontrar</span></span>
      </h2>

      <!-- PÁRRAFO DESCRIPTIVO (Con reveal-item y retraso de 450ms) -->
      <p class="text-lg text-slate-600 font-medium max-w-2xl leading-relaxed tracking-wide text-justify reveal-item [transition-delay:2400ms]">
        Cirujana dentista con experiencia en .... estudiante de la ujat blabla especializada en Tempus turpis laoreet commodo suspendisse commodo mus vitae molestie aliquet sodales lectus massa.
      </p>

    </div>

    <!-- ========================================================================= -->
    <!-- BLOQUE DE IMAGEN EN CAPAS 3D MANTENIENDO TUS TAMAÑOS EDITADOS AL 100% -->
    <!-- ========================================================================= -->
    <div class="lg:col-span-5 flex justify-center items-center relative overflow-visible h-[999px]">
      
      <!-- CONTENEDOR MAESTRO DE CONTROL DE COORDENADAS -->
      <div class="w-full max-w-[480px] h-[600px] relative flex items-center justify-center overflow-visible transform translate-y-[120px]">        
        
        <!-- CAPA 1: PICOS DE FONDO AZULES (Tus medidas exactas: max-w-[480px] h-[650px] y traslaciones) -->
        <div class="absolute inset-0 z-0 flex items-center justify-center">
          <Image 
            src={decorationImg} 
            alt="Decoración geométrica de fondo" 
            class="w-full max-w-[480px] h-[650px] object-fill block opacity-95 transform -translate-x-9 translate-y-8"
          />
        </div>

        <!-- CAPA 2: LA ESTELA DE LUZ AURORA (Tus medidas exactas: max-w-[480px] e inline duration) -->
        <div class="absolute inset-0 z-30 flex items-center justify-center animate-pulse [animation-duration:2s]">
          <img 
            src={import.meta.env.BASE_URL + 'Aurora.svg'}
            alt="Haz de luz curvo" 
            class="w-full max-w-[480px] h-auto object-contain block" 
          />
        </div>

        <!-- CAPA 3: LA FOTO CENTRAL DE LA DOCTORA (Tus medidas exactas: w-[700px], h-[1000px] y traslaciones) -->
        <div class="absolute inset-0 z-20 flex items-center justify-center w-[700px] max-w-none mx-auto">
          <Image 
            src={nosotrosComposicionImg} 
            alt="Cirujana Dentista Luz Elena" 
            class="w-full max-w-full h-[1000px] object-fill block transform translate-y-[60px] -translate-x-30"
          />
        </div>

        <!-- CAPA 4: SATÉLITES FLOTANTES -->
        
        <!-- CÍRCULO 1: LIMPIEZA DENTAL (Tus medidas exactas: top 10%, left 4%, w/h 160px) -->
        <div class="absolute top-[10%] left-[4%] w-[160px] h-[160px] z-10 animate-float-card">
          <Image 
            src={limpiezaImg} 
            alt="Caso de éxito limpieza dental" 
            class="w-full h-full object-contain block"
          />
        </div>

        <!-- CÍRCULO 2: EXTRACCIÓN DENTAL (Tus medidas exactas: bottom 0%, right 2%, w/h 160px) -->
        <div class="absolute bottom-[0%] right-[2%] w-[160px] h-[160px] z-30 animate-float-card-slow">
          <Image 
            src={extraccionImg} 
            alt="Operación clínica extracción" 
            class="w-full h-full object-contain block"
          />
        </div>

        <!-- DESTELLO DE RAYITAS BLING.SVG (Tus medidas exactas: top 9%, right 35%) -->
        <div class="absolute top-[9%] right-[35%] w-10 h-10 z-30 animate-pulse [animation-duration:2.8s]">
          <img 
            src={import.meta.env.BASE_URL + 'bling.svg'}
            alt="Brillo de destello" 
            class="w-full h-full object-contain" 
          />
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  /* ── Stat Cards (shadcn/Tremor-inspired) ── */
  .stat-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: 20px;
    padding: 22px 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    box-shadow:
      0 1px 2px rgba(0,0,0,0.05),
      0 4px 24px rgba(0,0,0,0.05);
    transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1),
                box-shadow 0.25s ease;
  }
  .stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 36px rgba(0,0,0,0.10);
  }

  .stat-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .stat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px; height: 36px;
    border-radius: 10px;
  }
  .stat-icon-blue  { background: #eff6ff; color: #0076c8; }
  .stat-icon-amber { background: #fffbeb; color: #d97706; }

  .stat-badge {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 3px 10px;
    border-radius: 999px;
  }
  .stat-badge-blue  { background: #eff6ff; color: #0076c8; border: 1px solid #bfdbfe; }
  .stat-badge-amber { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }

  .stat-metric {
    font-size: 2.4rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 2px;
  }

  .stat-sub {
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }

  .stat-desc {
    font-size: 0.8125rem;
    color: #64748b;
    line-height: 1.6;
  }
</style>

<script>
  function iniciarAnimacionNosotros() {
    const section = document.getElementById('nosotros-section');
    if (!section) return;

    // Forzamos el reinicio visual por si Astro cacheó la vista
    section.classList.remove('active');

    const observer = new IntersectionObserver((entries) => {
      // Tomamos la primera coincidencia
      const entrada = entries[0];
      
      if (entrada.isIntersecting) {
        // Agregamos la clase que dispara tu CSS
        section.classList.add('active');
        // Apagamos el observador para ahorrar recursos
        observer.disconnect();
      }
    }, {
      // EL TRUCO: Usamos un porcentaje (-30%). 
      // Esto le dice al navegador: "Ignora el 30% inferior de la pantalla".
      // Fuerza a que la sección tenga que subir físicamente con el scroll.
      rootMargin: "0px 0px -30% 0px",
      threshold: 0
    });

    // Le damos un respiro de 100ms a Tailwind para pintar el sticky
    setTimeout(() => {
      observer.observe(section);
    }, 100);
  }

  // Se ejecuta en la primera carga (los módulos de Astro lo hacen automáticamente)
  iniciarAnimacionNosotros();

  // Se ejecuta si estás usando ViewTransitions al cambiar de página
  document.addEventListener('astro:page-load', iniciarAnimacionNosotros);
</script>